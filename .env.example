# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 注意：开源版不含 /api/interpret 等后端接口，下面这组配置只在你自己实现了接口后才会用到；
# 只想排盘、看命盘的话不用填。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── 自建 AI 接口配置（app/api/interpret 与 app/api/heming）───
# 任意 OpenAI 兼容服务：填 base_url（到 /v1 为止）、key、模型名
AI_BASE_URL=https://tokenrhythm.studio/v1
AI_API_KEY=your-key
AI_MODEL=deepseek-v4.1-flash-1017
